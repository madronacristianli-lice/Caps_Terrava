JWT_SECRET=your_jwt_secret_here

# Database (Supabase PostgreSQL)
# Use the connection string from Supabase Dashboard > Project Settings > Database.
# Prefer the connection pooler URL with port 6543 for the server.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
TEXTBEE_API_KEY=your_textbee_api_key
# Optional: use a specific registered TextBee Android device
TEXTBEE_DEVICE_ID=your_textbee_device_id

# Google Identity Services OAuth 2.0 Web client ID. Must match the client value.
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Optional: legacy split database config used when DATABASE_URL is not set
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=terrava

# SMTP / Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Terrava <your_email@gmail.com>

# Ethereum / Sepolia
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
ETH_PRIVATE_KEY=0xYOUR_METAMASK_PRIVATE_KEY
CONTRACT_ADDRESS=0xDEPLOYED_CONTRACT_ADDRESS_HERE
