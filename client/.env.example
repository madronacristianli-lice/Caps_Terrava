# Google Identity Services OAuth 2.0 Web client ID.
# Add http://localhost:5173 as an authorized JavaScript origin in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# In the frontend Vercel project, set this to the deployed backend origin
# plus /api. The code also has this production fallback, but setting the
# variable explicitly is preferred.
VITE_API_URL=https://caps-terrava-1qx5.vercel.app/api
