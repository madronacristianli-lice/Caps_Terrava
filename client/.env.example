# Google Identity Services OAuth 2.0 Web client ID.
# Add http://localhost:5173 as an authorized JavaScript origin in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Local development can use the Vite proxy. In Vercel, set this to the
# deployed backend origin plus /api, for example:
# VITE_API_URL=https://your-backend.vercel.app/api
VITE_API_URL=/api
